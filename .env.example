# ==============================================================================
# MEDIFLOW LIS - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Modern Blood Diagnostic Laboratory Management Software / Enterprise LIS / SaaS
# ==============================================================================

# Node Environment: development | test | staging | production
NODE_ENV=production
PORT=5000
API_BASE_URL=https://api.mediflow.io
CLIENT_BASE_URL=https://app.mediflow.io

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Driver: sqlite | postgres
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://mediflow_admin:CHANGE_ME_STRONG_PASSWORD@db.mediflow.internal:5432/mediflow_lis
SQLITE_FILE_PATH=./data/blood_lis.db

# ------------------------------------------------------------------------------
# AUTHENTICATION & TOKENS
# ------------------------------------------------------------------------------
# Must be cryptographically random 32+ character secrets
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_64_CHAR_HEX_SECRET_STRING_KEY_0123456789
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_SECURE_RANDOM_64_CHAR_HEX_REFRESH_KEY
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# CRYPTOGRAPHIC ENCRYPTION (AES-256-GCM)
# ------------------------------------------------------------------------------
# Exactly 32 bytes hex string used to encrypt credentials and stored webhook secrets
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# RATE LIMITING & SECURITY
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX=10

# ------------------------------------------------------------------------------
# STORAGE PROVIDER
# ------------------------------------------------------------------------------
# Provider: local | s3 | gcs
STORAGE_PROVIDER=local
LOCAL_UPLOAD_PATH=./uploads
MAX_FILE_SIZE_BYTES=20971520

# Optional S3 bucket settings
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
S3_BUCKET_NAME=mediflow-secure-documents

# ------------------------------------------------------------------------------
# NOTIFICATION CHANNELS (EMAIL, SMS, WHATSAPP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.mediflow.io
SMTP_PASS=placeholder-smtp-password
SMTP_FROM_EMAIL=reports@mediflow.io

SMS_PROVIDER_API_KEY=placeholder-msg91-dlt-api-key
SMS_SENDER_ID=MEDLAB

WHATSAPP_API_TOKEN=placeholder-meta-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=109876543210987

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY SETTINGS
# ------------------------------------------------------------------------------
# Provider: mock | razorpay | stripe
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
STRIPE_SECRET_KEY=sk_live_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ------------------------------------------------------------------------------
# TELEMETRY, LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
ENABLE_METRICS=true
LOG_LEVEL=info
