{
  "name": "lis-backend",
  "version": "1.0.0",
  "description": "Blood Diagnostic Laboratory Information System (LIS) Backend API",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"const fs=require('fs'),path=require('path'),s='src/db/schema.sql',d='dist/db/schema.sql';fs.mkdirSync(path.dirname(d),{recursive:true});fs.copyFileSync(s,d);\"",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:status": "tsx src/db/migrate.ts status",
    "migrate:check": "tsx src/db/migrate.ts check",
    "seed": "tsx src/db/seed.ts",
    "test:core": "tsx src/tests/coreSystem.test.ts",
    "test:phase3": "tsx src/tests/phase3System.test.ts",
    "test:phase4": "tsx src/tests/phase4System.test.ts",
    "test:phase5": "tsx src/tests/phase5System.test.ts",
    "test:phase6": "tsx src/tests/phase6System.test.ts",
    "test:phase7": "tsx src/tests/phase7System.test.ts",
    "test:e2e": "tsx src/tests/endToEndClinical.test.ts",
    "test:security": "tsx src/tests/securityHardening.test.ts",
    "test:import": "tsx src/tests/dataMigration.test.ts",
    "test:billing": "tsx src/tests/subscriptionBilling.test.ts",
    "test:phase9": "tsx src/tests/phase9EnterpriseOps.test.ts",
    "test:architecture": "tsx src/tests/architectureGovernance.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "blood-diagnostic-lis": "file:..",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.16.0",
    "pg": "^8.13.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
