# MediFlow LIS — Production Backend Environment Configuration
PORT=5000
NODE_ENV=production

# Database Configuration
# Set DB_TYPE=postgres in production or DB_TYPE=auto / sqlite in local development
DB_TYPE=postgres
DATABASE_URL=postgresql://mediflow_admin:SecureClinicalPass2026!@localhost:5432/mediflow_lis_prod
DB_HOST=localhost
DB_PORT=5432
DB_USER=mediflow_admin
DB_PASSWORD=SecureClinicalPass2026!
DB_NAME=mediflow_lis_prod

# JWT Authentication & Keystores
JWT_SECRET=production_super_secure_clinical_lis_jwt_secret_key_2026_x89!
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=production_super_secure_refresh_secret_key_2026_q41!

# Communication Providers & API Keys (Optional overrides)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.your_sendgrid_api_key_here
SMTP_FROM=reports@yourdiagnosticlab.com

SMS_GATEWAY_URL=https://api.msg91.com/api/v5/flow/
SMS_AUTH_KEY=your_msg91_auth_key_here
SMS_SENDER_ID=MEDLAB

WHATSAPP_API_URL=https://graph.facebook.com/v19.0/your_phone_number_id/messages
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token_here

# Storage & File Attachments
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
