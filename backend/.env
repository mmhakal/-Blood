PORT=5000
NODE_ENV=development

# Database configuration
# Set DB_TYPE=postgres to use local or remote PostgreSQL
# If DB_TYPE=postgres and connection fails, the system automatically falls back to embedded SQLite database for zero-downtime development.
DB_TYPE=auto
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blood_lis_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=blood_lis_db

# Security & JWT
JWT_SECRET=super_secure_clinical_lis_jwt_secret_key_2026_x89!
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=super_secure_clinical_refresh_secret_key_2026_q41!

# Uploads & Storage
UPLOAD_DIR=../uploads
MAX_FILE_SIZE_MB=10

# System info
APP_NAME="MediFlow LIS - Diagnostic Laboratory Information System"
APP_VERSION=1.0.0
